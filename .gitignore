# Source checkpoint: admit authored source and selected reviewed evidence only.
*
!*/
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/docs/**/*.md
!/scripts/*.ps1
!/analysis/**/*.py
!/analysis/**/*.sh
!/analysis/**/*.c
!/analysis/display-takeover/key3-gesture.h
!/analysis/display-takeover/drawer-gesture.h
!/analysis/display-takeover/github-card-logo.h
!/analysis/**/*.S
!/analysis/**/*.ld
!/analysis/**/*.tcl
!/analysis/**/*.md
!/analysis/**/*.cfg
!/diagnostics/*.py
!/diagnostics/*.cfg

# Private captures, vendor firmware, installed toolchains and generated runs.
/backups/
/tools/
**/__pycache__/
**/python-packages/
**/reference/
/analysis/romfs/
/analysis/display-takeover/romfs-*/
/analysis/logs/
/analysis/display-takeover/manual-*/
/analysis/display-takeover/color-round*/
/analysis/display-takeover/dsi-bist-round*/
/analysis/display-takeover/touch-live-preflight-offline/
/analysis/persistence/native-counter-pink-reviewed/
/analysis/persistence/*-session-*/
/analysis/persistence/*-hardware-*/
/analysis/persistence/native-read-*/
/analysis/persistence/mock-read-runner-*/
**/offline-*/
/analysis/fs/unqlite-upstream.c
/analysis/fs/nuttx-*.h

# These generated Tcl arrays contain original firmware/sector bytes.
/diagnostics/*-stage-inputs.cfg
/analysis/persistence/boot-nor-read-runner-data.cfg

